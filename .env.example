# WordPress GraphQL Endpoint
NEXT_PUBLIC_WP_URL=https://your-wordpress-site.com/graphql

# Admin Panel Password
ADMIN_PASSWORD=your_secure_password

# JSON Bin Configuration
JSON_BIN_ID=your_jsonbin_id
JSON_BIN_API_KEY=your_jsonbin_api_key
JSON_BIN_BASE_URL=https://api.jsonbin.io/v3/b

# X promotion (/admin/x)
# OAuth 1.0a keys of the X developer app, generated for the @PAG_UM account.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# Vercel AI Gateway — writes the post. Not needed on Vercel (OIDC covers it).
AI_GATEWAY_API_KEY=
AI_MODEL=anthropic/claude-sonnet-4.6

# Facebook promotion (/admin/facebook)
# Numeric id of the PÁGINA UM Page and a long-lived Page access token
# (Meta app > Graph API Explorer > page token, extended; needs
# pages_manage_posts + pages_read_engagement + pages_show_list).
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=